{
	"name": "uma-memo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.16.1",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && wrangler types",
		"check": "svelte-kit sync && wrangler types && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && wrangler types && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && pnpm run docs:check",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install chromium && playwright test",
		"verify": "pnpm run check && pnpm run lint && pnpm run test:unit -- --run && pnpm run test:e2e",
		"screens": "playwright install chromium && node --experimental-strip-types scripts/screens.ts",
		"screens:pr": "node --experimental-strip-types scripts/pr-screens.ts",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply k-note --local",
		"db:migrate:remote": "wrangler d1 migrations apply k-note --remote",
		"db:migrate:staging": "wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.toml",
		"deploy": "vite build && wrangler deploy",
		"docs:check": "node --experimental-strip-types scripts/check-docs.ts",
		"pr:check": "node --experimental-strip-types scripts/check-pr-body.ts",
		"deploy:staging": "vite build && wrangler preview --name staging",
		"data:check": "node --experimental-strip-types scripts/import-races.ts --check",
		"data:sql:local": "node --experimental-strip-types scripts/import-races.ts --target local --out .wrangler/import-races.sql",
		"data:sql:remote": "node --experimental-strip-types scripts/import-races.ts --target remote --out .wrangler/import-races.sql",
		"data:sql:staging": "node --experimental-strip-types scripts/import-races.ts --target remote --all --out .wrangler/import-races-staging.sql",
		"data:import:local": "pnpm run data:sql:local && wrangler d1 execute k-note --local --file .wrangler/import-races.sql",
		"data:import:remote": "pnpm run data:sql:remote && wrangler d1 execute k-note --remote --file .wrangler/import-races.sql",
		"data:import:staging": "pnpm run data:sql:staging && wrangler d1 execute PREVIEW_DB --remote --config wrangler.preview-migrations.toml --file .wrangler/import-races-staging.sql"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.47.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.19.2",
		"cn": "^0.3.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.135.0",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"arctic": "^3.7.0",
		"drizzle-orm": "^0.45.2",
		"ulidx": "^2.4.1",
		"valibot": "^1.5.0"
	}
}
