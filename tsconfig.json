{
	"extends": "$app/tsconfig",
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		// 生成物は型検査しない。wrangler.toml の main（src/worker.js）はビルド成果物の
		// .svelte-kit/cloudflare/_worker.js を import するため、checkJs を有効に
		// すると svelte-check がビルド成果物まで検査し、ビルド前には import が解決できず落ちる。
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		// `$app/types` は SvelteKit が要るので落とさない（kit 3 の検査が見る）
		"types": ["$app/types", "./worker-configuration.d.ts"]
	}
}
