{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Bash(*run deploy*)",
			"Bash(pnpm deploy*)",
			"Bash(*db:migrate:remote*)",
			"Bash(*db:migrate:staging*)",
			"Bash(*data:import:remote*)",
			"Bash(*data:import:staging*)",
			"Bash(pnpm run odds:update)",
			"Bash(pnpm odds:update)",
			"Bash(*wrangler deploy*)",
			"Bash(*wrangler secret*)",
			"Bash(*--remote*)",
			"Bash(gh pr merge*)",
			"Bash(gh api */merge*)",
			"Bash(git -C * push*)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push * --force*)",
			"Bash(git push * -f*)",
			"Bash(git push *+*)",
			"Bash(git push * main)",
			"Bash(git push * main *)",
			"Bash(git push *:main)",
			"Bash(git push *:main *)"
		]
	}
}
